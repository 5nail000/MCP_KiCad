# Workspace root. Cursor MCP sets this automatically.
# KICAD_AI_WORKSPACE=C:\Cursor_Projects\MCP_KiCad

# Optional overrides if auto-detection of KiCad 10 fails.
# KICAD_EXE=C:\Program Files\KiCad\10.0\bin\kicad.exe
# KICAD_CLI=C:\Program Files\KiCad\10.0\bin\kicad-cli.exe
# KICAD_SYMBOL_DIR=C:\Program Files\KiCad\10.0\share\kicad\symbols
# KICAD_FOOTPRINT_DIR=C:\Program Files\KiCad\10.0\share\kicad\footprints

# Backup retention per project directory name.
# KICAD_AI_BACKUP_KEEP=10

# Log level: DEBUG, INFO, WARNING, ERROR
# KICAD_AI_LOG_LEVEL=INFO
